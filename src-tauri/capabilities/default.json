{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main Weird Science window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "sql:allow-load",
      "allow": ["sqlite:$APPDATA/vault/weird-science.db"]
    },
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/vault"
        },
        {
          "path": "$APPDATA/vault/**"
        }
      ]
    },
    "allow-ollama-chat",
    "allow-ollama-embed",
    "allow-hosted-chat",
    "allow-vault-path",
    "allow-cancel-stream"
  ]
}
